    <shortcut
        android:shortcutId="open_seima"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_open_seima_short"
        android:shortcutLongLabel="@string/shortcut_open_seima_long"
        android:shortcutDisabledMessage="@string/shortcut_open_seima_disabled">
        <intent
            android:action="com.example.seima.ACTION_OPEN_SEIMA"
            android:targetPackage="com.example.seima"
            android:targetClass="com.example.seima.MainActivity" />
    </shortcut>
